# =====================================================================
# .editorconfig
#
# 에디터가 C# 파일을 "어떤 인코딩으로 저장할지" 를 레포 차원에서 못박는다.
# Visual Studio / Rider / VS Code(EditorConfig 확장) 가 이 파일을 자동으로 읽는다.
# ★각자 세팅할 것 없음 - 레포에 이 파일이 있기만 하면 먹는다.
#
# 왜 필요한가 (2026-08-03 사고):
#   .cs 파일에는 인코딩 정보가 안 들어 있어서 에디터가 열 때 추측한다.
#   - 한글 윈도우 Visual Studio: 애매하면 CP949(시스템 기본)로 저장
#   - VS Code / Rider: 무조건 UTF-8 로 읽음
#   그래서 CP949 로 저장된 파일을 UTF-8 에디터가 열면 한글 주석이
#   전부 물음표(U+FFFD)로 바뀌어 저장된다. 되돌릴 수 없다(git 원본으로만 복구 가능).
#   실제로 BeltItemVisual.cs / SplitStackPopupUI.cs 가 이렇게 망가졌다.
#
# charset 을 utf-8-bom 이 아니라 utf-8 로 둔 이유:
#   BOM 으로 두면 각자 파일을 저장할 때마다 BOM 이 붙어서 관계없는 커밋에
#   diff 가 섞인다. BOM 일괄 적용은 별도 결정 사항.
# =====================================================================

root = true

[*.cs]
charset = utf-8
end_of_line = crlf
indent_style = space
indent_size = 4
