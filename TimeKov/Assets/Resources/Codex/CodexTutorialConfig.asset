%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a0a1d140ce4c4354699e57ac1ab08bc8, type: 3}
  m_Name: CodexTutorialConfig
  m_EditorClassIdentifier: 
  pages:
  - clip: {fileID: 32900000, guid: cbc7c1b2c1891d743aa71dcdffcbf868, type: 3}
    title: "\uC124\uBE44 \uC124\uCE58"
    body: "<color=#FFCC00>\uAC74\uC124 \uBAA8\uB4DC(B)</color>\uC5D0\uC11C <color=#FFCC00>\uD035\uC2AC\uB86F</color>\uC758
      \uC124\uBE44\uB97C \uACE0\uB978 \uB4A4 <color=#FFCC00>\uAC74\uC124 \uAD6C\uC5ED</color>
      \uBC14\uB2E5\uC744 \uD074\uB9AD\uD574 \uC124\uCE58\uD569\uB2C8\uB2E4. \uB193\uC744
      \uC218 \uC788\uC73C\uBA74 <color=#FFCC00>\uCD08\uB85D</color>, \uC548 \uB418\uBA74
      <color=#FFCC00>\uBE68\uAC15</color>\uC73C\uB85C \uD45C\uC2DC\uB3FC\uC694. (<color=#FFCC00>R</color>\uB85C
      \uD68C\uC804)"
  - clip: {fileID: 32900000, guid: c96f6ec927cb24446bcfcc7f9c00c6d8, type: 3}
    title: "\uC124\uBE44 \uD574\uC81C"
    body: "<color=#FFCC00>X</color>\uB85C <color=#FFCC00>\uD574\uC81C \uBAA8\uB4DC</color>\uC5D0
      \uB4E4\uC5B4\uAC00 \uC124\uBE44\uB97C <color=#FFCC00>\uD074\uB9AD</color>\uD558\uBA74
      \uCCA0\uAC70\uB429\uB2C8\uB2E4. <color=#FFCC00>Shift</color>\uB97C \uB204\uB978
      \uCC44 <color=#FFCC00>\uB4DC\uB798\uADF8</color>\uD558\uBA74 <color=#FFCC00>\uC5EC\uB7EC
      \uAC1C\uB97C \uD55C \uBC88\uC5D0</color> \uD574\uC81C\uD560 \uC218 \uC788\uC5B4\uC694."
  - clip: {fileID: 32900000, guid: d49db4d5168dd9e45b71b123a6fcd517, type: 3}
    title: "\uCF54\uC5B4 \uAC15\uD654\uB780"
    body: "<color=#FFCC00>F</color>\uB85C \uC5EC\uB294 <color=#FFCC00>\uCF54\uC5B4
      \uAC15\uD654 \uB2E8\uB9D0</color>\uC785\uB2C8\uB2E4. <color=#FFCC00>\uCF54\uC5B4
      \uAC15\uD654</color>\uB85C <color=#FFCC00>\uCD5C\uB300 \uC2DC\uAC04(\uCCB4\uB825)</color>\uC744
      \uB298\uB9AC\uBA70, \uB2E8\uACC4\uAC00 \uC624\uB97C\uC218\uB85D \uB354 \uB9CE\uC740
      <color=#FFCC00>\uCF54\uC5B4 \uD0A4\uD2B8</color>\uAC00 \uD544\uC694\uD569\uB2C8\uB2E4(<color=#FFCC00>\uCF54\uC5B4
      \uD569\uC131\uAE30</color>\uC5D0\uC11C \uC81C\uC791). \uAC15\uD654\uB294 <color=#FFCC00>\uC131\uACF5\xB7\uC2E4\uD328\uC640
      \uBB34\uAD00\uD558\uAC8C \uD0A4\uD2B8\uB97C \uC18C\uBAA8</color>\uD558\uB2C8
      <color=#FFCC00>\uC131\uACF5 \uD655\uB960</color>\uC744 \uAF2D \uD655\uC778\uD558\uC138\uC694."
  - clip: {fileID: 32900000, guid: 53ba06e4b22d9fd469c752fec4ab3a85, type: 3}
    title: "\uCF54\uC5B4 \uAC15\uD654 \uBC29\uBC95"
    body: "<color=#FFCC00>\uAC15\uD654 \uC2DC\uC791</color>\uC744 \uB204\uB974\uBA74
      \uCF54\uC5B4\uAC00 <color=#FFCC00>\uC2DC\uACC4</color>\uB85C \uBC14\uB01D\uB2C8\uB2E4.
      \uBC14\uB298\uC774 <color=#FFCC00>\uCD08\uB85D \uC131\uACF5\uC874</color>\uC5D0
      \uC62C \uB54C <color=#FFCC00>\uC815\uC9C0! \uBC84\uD2BC(\uB610\uB294 Space)</color>\uC73C\uB85C
      \uBA48\uCD94\uBA74 \uC131\uACF5 \uD655\uB960\uC774 \uC624\uB985\uB2C8\uB2E4.
      <color=#FFCC00>\uAC15\uD654 \uBC84\uD2BC</color>\uACFC <color=#FFCC00>\uC131\uACF5
      \uD655\uB960 \uBC14</color>\uB294 \uCF54\uC5B4 \uAC15\uD654 \uCC3D\uC5D0 \uC788\uC2B5\uB2C8\uB2E4."
  - clip: {fileID: 32900000, guid: 7a195cb5442f14a42982ae5b7dd0398e, type: 3}
    title: "\uC124\uBE44 \uC5F4\uAE30"
    body: "\uC124\uCE58\uD55C \uC124\uBE44\uC5D0 \uB2E4\uAC00\uAC00 <color=#FFCC00>F</color>\uB97C
      \uB204\uB974\uBA74 \uC124\uBE44 UI\uAC00 \uC5F4\uB9BD\uB2C8\uB2E4. \uC774 \uD654\uBA74\uC5D0\uC11C
      <color=#FFCC00>\uC5F0\uB8CC</color>\uC640 <color=#FFCC00>\uC7AC\uB8CC</color>\uB97C
      \uB123\uC5B4 \uC6D0\uD558\uB294 \uBB3C\uAC74\uC744 <color=#FFCC00>\uAC00\uACF5</color>\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - clip: {fileID: 32900000, guid: 051bc50f018f7ad4d8a98ad2578168d7, type: 3}
    title: "\uC7AC\uB8CC \uD22C\uC785\uACFC \uAC00\uACF5"
    body: "\uBA3C\uC800 <color=#FFCC00>\uC5F0\uB8CC</color>\uAC00 \uD544\uC694\uD569\uB2C8\uB2E4.
      \uAC00\uBC29\uC758 <color=#FFCC00>\uB098\uBB47\uAC00\uC9C0</color>\uB97C <color=#FFCC00>\uC5F0\uB8CC
      \uC2AC\uB86F</color>\uC5D0 \uB4DC\uB798\uADF8\uD574 \uB123\uC73C\uC138\uC694(\uB098\uBB47\uAC00\uC9C0\uB294
      <color=#FFCC00>\uC624\uD06C \uD2B8\uB9AC</color>\uC5D0\uC11C \uB098\uC635\uB2C8\uB2E4).
      \uC774\uC5B4\uC11C <color=#FFCC00>\uAC00\uBC29\uC774\uB098 \uCC3D\uACE0</color>\uC758
      \uC7AC\uB8CC\uB97C <color=#FFCC00>\uC7AC\uB8CC \uC2AC\uB86F</color>\uC73C\uB85C
      \uB4DC\uB798\uADF8\uD558\uBA74, \uB9DE\uB294 <color=#FFCC00>\uB808\uC2DC\uD53C</color>\uAC00
      \uC788\uC744 \uB54C <color=#FFCC00>\uAC00\uACF5</color>\uC774 \uC2DC\uC791\uB429\uB2C8\uB2E4."
  - clip: {fileID: 32900000, guid: 93fdb0467e9e1d64794e128ab30f0e06, type: 3}
    title: "\uC0DD\uC0B0\uD488 \uC218\uB839"
    body: "<color=#FFCC00>\uAC00\uACF5\uC774 \uC644\uB8CC</color>\uB418\uBA74 <color=#FFCC00>\uBAA8\uB450
      \uBC1B\uAE30</color>\uB85C \uC0DD\uC0B0\uD488\uC744 \uAC00\uBC29\uC774\uB098
      \uCC3D\uACE0\uB85C <color=#FFCC00>\uC218\uB839</color>\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - clip: {fileID: 32900000, guid: d7bc022beed29754ab036915378f45c9, type: 3}
    title: "\uB808\uC2DC\uD53C \uBCC0\uACBD"
    body: "\uD55C \uC124\uBE44\uAC00 \uC5EC\uB7EC <color=#FFCC00>\uB808\uC2DC\uD53C</color>\uB97C
      \uB9CC\uB4E4 \uC218 \uC788\uC744 \uB54C, \uB9CC\uB4E4\uACE0 \uC2F6\uC740 <color=#FFCC00>\uB808\uC2DC\uD53C</color>\uB97C
      <color=#FFCC00>\uD074\uB9AD</color>\uD574 <color=#FFCC00>\uBC14\uAFC0 \uC218
      \uC788\uC2B5\uB2C8\uB2E4</color>. (\uD55C \uBC88\uC5D0 \uD558\uB098\uC758 \uB808\uC2DC\uD53C\uB9CC
      \uAC00\uB3D9)"
  - clip: {fileID: 32900000, guid: 4b7389858e0f07a4a9f79314f9471ad7, type: 3}
    title: "\uACB0\uACC4 \uC548\uACFC \uBC16"
    body: "\uACB0\uACC4 \uC548\uC5D0\uC11C\uB294 <color=#FFCC00>\uC2DC\uAC04 \uAC10\uC18C\uAC00
      \uBA48\uCDA5\uB2C8\uB2E4</color>. \uACB0\uACC4 \uBC16\uC5D0\uC11C\uB294 <color=#FFCC00>\uC2DC\uAC04\uC774
      \uC904\uC5B4\uB4ED\uB2C8\uB2E4</color>."
  - clip: {fileID: 32900000, guid: d0bb1133a0c1f5c4896448e7e94d3be8, type: 3}
    title: "\uC544\uC774\uD15C \uC90D\uAE30"
    body: "\uC801\uC774\uB098 \uC624\uBE0C\uC81D\uD2B8\uC5D0\uC11C \uB098\uC628 <color=#FFCC00>\uC544\uC774\uD15C</color>\uC740
      \uAC00\uAE4C\uC774 \uAC00\uBA74 <color=#FFCC00>\uD68D\uB4DD</color>\uB429\uB2C8\uB2E4."
  - clip: {fileID: 32900000, guid: 045e7a2fb10fdf54b83a0689b49beaa8, type: 3}
    title: "\uCC3D\uACE0"
    body: "<color=#FFCC00>\uAC00\uBC29</color>\uC774 \uAC00\uB4DD \uCC28\uBA74 \uC544\uC774\uD15C\uC774
      <color=#FFCC00>\uCC3D\uACE0</color>\uB85C \uC790\uB3D9 \uBCF4\uAD00\uB429\uB2C8\uB2E4.
      \uCC3D\uACE0\uB97C \uC5F4\uC5B4 \uD544\uC694\uD55C \uC544\uC774\uD15C\uC744
      <color=#FFCC00>\uAEBC\uB0B4 \uC4F8 \uC218 \uC788\uC5B4\uC694</color>."
  - clip: {fileID: 32900000, guid: b7462c6b24adec0489614fe5884a7d1d, type: 3}
    title: "\uC0C1\uC790\uD30C\uBC0D"
    body: "\uB9F5\uC5D0\uC11C \uBC1C\uACAC\uD55C <color=#FFCC00>\uC0C1\uC790</color>\uB294
      <color=#FFCC00>F</color>\uB85C \uC5FD\uB2C8\uB2E4. <color=#FFCC00>\uB4F1\uAE09
      \uB192\uC740</color> \uC544\uC774\uD15C\uC774 \uB4E4\uC5B4 \uC788\uC5B4\uC694."
  - clip: {fileID: 32900000, guid: a4b4fedbdcd3b59479a1e0cd6e6f715d, type: 3}
    title: "\uC989\uC2DC\uC644\uB8CC"
    body: "\uAE30\uB2E4\uB9AC\uC9C0 \uC54A\uACE0 <color=#FFCC00>G</color>\uB97C \uB20C\uB7EC
      \uC0C1\uC790\uB97C <color=#FFCC00>\uC989\uC2DC</color> \uC5F4 \uC218\uB3C4
      \uC788\uC2B5\uB2C8\uB2E4."
  - clip: {fileID: 32900000, guid: fbd0472139b22b9459c5c718c726eb43, type: 3}
    title: "\uD035\uC2AC\uB86F \uB4F1\uB85D"
    body: "\uC790\uC8FC \uC4F0\uB294 \uC544\uC774\uD15C\uC740 <color=#FFCC00>\uD035\uC2AC\uB86F</color>\uC5D0
      \uB4F1\uB85D\uD574 \uBE60\uB974\uAC8C \uC0AC\uC6A9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.
      \uC778\uBCA4\uD1A0\uB9AC\uC5D0\uC11C <color=#FFCC00>\uC6B0\uD074\uB9AD -> \uD035\uC2AC\uB86F
      \uB4F1\uB85D</color>, \uC0AC\uC6A9\uC740 <color=#FFCC00>V</color>\uC785\uB2C8\uB2E4.
      (<color=#FFCC00>\uAC00\uBC29\uC5D0 \uC788\uC744 \uB54C\uB9CC</color> \uC0AC\uC6A9\uB429\uB2C8\uB2E4)"
  - clip: {fileID: 32900000, guid: 530a9468607c2dc498780c69689e00ec, type: 3}
    title: "\uB808\uC77C \uC790\uB3D9\uD654\uB780"
    body: "\uC774\uC81C <color=#FFCC00>\uC790\uB3D9\uD654</color>\uB97C \uBC30\uC6CC\uBD05\uC2DC\uB2E4.
      \uC124\uBE44\uB97C <color=#FFCC00>\uB808\uC77C</color>\uB85C \uC774\uC73C\uBA74,
      \uC544\uC774\uD15C\uC774 <color=#FFCC00>\uC790\uB3D9\uC73C\uB85C</color> \uB2E4\uC74C
      \uC124\uBE44\uB85C \uC774\uB3D9\uD574 <color=#FFCC00>\uC9C1\uC811 \uD68C\uC218</color>\uD560
      \uD544\uC694\uAC00 \uC5C6\uC5B4\uC9D1\uB2C8\uB2E4. (\uB808\uC77C\uC740 <color=#FFCC00>\uAC74\uC124
      \uBAA8\uB4DC(B)</color>\uC5D0\uC11C \uAE5D\uB2C8\uB2E4)"
  - clip: {fileID: 32900000, guid: e514d802ace2a664889b240df52971b5, type: 3}
    title: "\uB808\uC77C \uAE4C\uB294 \uBC95"
    body: "<color=#FFCC00>\uAC74\uC124 \uBAA8\uB4DC(B)</color>\uC5D0\uC11C <color=#FFCC00>\uB808\uC77C(E)</color>\uC744
      \uACE0\uB978 \uB4A4, \uC124\uBE44\uC758 <color=#FFCC00>\uCD9C\uAD6C(E \uD45C\uC2DC)</color>\uB97C
      \uD074\uB9AD\uD574 \uB2E4\uC74C \uC124\uBE44\uAE4C\uC9C0 \uC774\uC5B4 \uC8FC\uC138\uC694."
  - clip: {fileID: 32900000, guid: bfb865c22bb8dcf418ba01cb7292ad9f, type: 3}
    title: "\uC2DC\uAC04\uC5D0\uB108\uC9C0 \uC804\uC1A1"
    body: "<color=#FFCC00>\uCDA9\uC804 \uD0A4\uD2B8</color>\uB97C \uC804\uC1A1\uD558\uBA74
      <color=#FFCC00>\uC804\uC1A1\uB960</color>\uC774 \uC624\uB985\uB2C8\uB2E4. \uC804\uC1A1\uB960\uC774
      \uC624\uB974\uBA74 <color=#FFCC00>\uBCF4\uAE09 \uC2E0\uD638</color>\uC640 \uB2E4\uC74C
      \uBAA9\uD45C\uAC00 \uC5F4\uB9BD\uB2C8\uB2E4."
  - clip: {fileID: 32900000, guid: 5d6748ac97b814b419d8876d8ea5c8df, type: 3}
    title: "\uC2DC\uAC04\uC5D0\uB108\uC9C0 \uD569\uC131\uAE30 \uC18C\uAC1C"
    body: "\uC2DC\uAC04\uC5D0\uB108\uC9C0 <color=#FFCC00>\uCDA9\uC804 \uD0A4\uD2B8</color>\uB97C
      \uB9CC\uB4DC\uB294 \uC124\uBE44\uC785\uB2C8\uB2E4. \uC5EC\uAE30\uC11C \uB9CC\uB4E0
      \uD0A4\uD2B8\uB97C <color=#FFCC00>\uC804\uC1A1\uAE30</color>\uC5D0 \uB123\uC5B4
      \uC804\uC1A1\uB960\uC744 \uC62C\uB9BD\uB2C8\uB2E4."
  - clip: {fileID: 32900000, guid: f142b317af7ed3348815c9a0a3792e00, type: 3}
    title: "\uC6A9\uD574\uB85C \uC18C\uAC1C"
    body: "\uC7AC\uB8CC\uB97C \uB179\uC5EC <color=#FFCC00>\uC8FC\uAD34</color> \uB4F1
      \uAE30\uCD08 \uC18C\uC7AC\uB97C \uB9CC\uB4DC\uB294 \uC124\uBE44\uC785\uB2C8\uB2E4."
  - clip: {fileID: 32900000, guid: 322ca78250a9b844d876659acfec8580, type: 3}
    title: "\uCC3D\uACE0 \uCD9C\uB825 \uD3EC\uD2B8 \uC18C\uAC1C"
    body: "<color=#FFCC00>\uCC3D\uACE0</color>\uC758 \uC544\uC774\uD15C\uC744 <color=#FFCC00>\uB808\uC77C</color>\uB85C
      \uAEBC\uB0B4 \uB2E4\uB978 \uC124\uBE44\uC5D0 \uC790\uB3D9 \uACF5\uAE09\uD558\uB294
      \uC124\uBE44\uC785\uB2C8\uB2E4."
  - clip: {fileID: 32900000, guid: 81dd591bc4bda294fb98fce2f0e9ed68, type: 3}
    title: "\uC800\uC7A5\uACE0 \uC18C\uAC1C"
    body: "\uB808\uC77C\uB85C \uB4E4\uC5B4\uC628 \uC544\uC774\uD15C\uC744 <color=#FFCC00>\uCC3D\uACE0\uC5D0
      \uC790\uB3D9 \uBCF4\uAD00</color>\uD558\uB294 \uC124\uBE44\uC785\uB2C8\uB2E4.
      <color=#FFCC00>\uCC3D\uACE0 \uCD9C\uB825 \uD3EC\uD2B8</color>(\uCC3D\uACE0\uC5D0\uC11C
      \uAEBC\uB0B4\uAE30)\uC758 \uBC18\uB300\uC785\uB2C8\uB2E4."
  - clip: {fileID: 32900000, guid: 4f10f2e33ccf64b449ee181d491128da, type: 3}
    title: "\uCF54\uC5B4 \uD569\uC131\uAE30 \uC18C\uAC1C"
    body: "<color=#FFCC00>\uCF54\uC5B4 \uAC15\uD654</color>\uC5D0 \uC4F0\uB294 <color=#FFCC00>\uCF54\uC5B4
      \uD0A4\uD2B8</color>\uB97C \uB9CC\uB4DC\uB294 \uC124\uBE44\uC785\uB2C8\uB2E4."
  - clip: {fileID: 32900000, guid: 9e4ba08630d61b44b81b099c950b31d0, type: 3}
    title: "\uC0DD\uCCB4 \uBD84\uB9AC\uAE30 \uC18C\uAC1C"
    body: "\uC0DD\uCCB4 \uC7AC\uB8CC\uB97C \uBD84\uB9AC\uD574 <color=#FFCC00>\uC0C1\uC704
      \uC6D0\uB8CC</color>\uB97C \uC5BB\uB294 \uC124\uBE44\uC785\uB2C8\uB2E4. <color=#FFCC00>\uC5D0\uB108\uC9C0
      \uBCC0\uD658\uAE30</color>\uC640 \uD568\uAED8 \uC501\uB2C8\uB2E4."
  - clip: {fileID: 32900000, guid: c2d159ca6445c394ab52f9d177367dfa, type: 3}
    title: "\uC5D0\uB108\uC9C0 \uBCC0\uD658\uAE30 \uC18C\uAC1C"
    body: "\uC6D0\uB8CC\uB97C <color=#FFCC00>\uC5D0\uB108\uC9C0 \uD615\uD0DC</color>\uB85C
      \uBCC0\uD658\uD558\uB294 \uC124\uBE44\uC785\uB2C8\uB2E4. <color=#FFCC00>\uC0DD\uCCB4
      \uBD84\uB9AC\uAE30</color>\uC758 \uC0B0\uCD9C\uBB3C\uC744 \uBC1B\uC544 \uAC00\uACF5\uD569\uB2C8\uB2E4."
  - clip: {fileID: 32900000, guid: 13d959e406b878b469ce2c64998d5771, type: 3}
    title: "\uC6D0\uC7AC\uB8CC \uBB34\uD55C \uBCF5\uC81C"
    body: "<color=#FFCC00>\uC0DD\uCCB4 \uBD84\uB9AC\uAE30</color>\uC640 <color=#FFCC00>\uC5D0\uB108\uC9C0
      \uBCC0\uD658\uAE30</color>\uC758 \uCD9C\uB825\uC744 <color=#FFCC00>\uB808\uC77C</color>\uB85C
      \uC11C\uB85C \uBB3C\uB824 \uC21C\uD658\uC2DC\uD0A4\uBA74 \uC6D0\uC7AC\uB8CC\uAC00
      \uACC4\uC18D \uBD88\uC5B4\uB0A9\uB2C8\uB2E4. \uC774 <color=#FFCC00>\uC21C\uD658
      \uB77C\uC778</color>\uC73C\uB85C \uC7AC\uB8CC\uB97C \uBB34\uD55C\uD788 \uD655\uBCF4\uD558\uC138\uC694."
  - clip: {fileID: 32900000, guid: 15d371dcb197d2b4982308056828139e, type: 3}
    title: "\uADC0\uD658\uC11D"
    body: "<color=#FFCC00>\uADC0\uD658\uC11D</color>\uC744 \uC0AC\uC6A9\uD558\uBA74
      \uAE30\uC9C0\uB85C \uBE60\uB974\uAC8C \uBCF5\uADC0\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.
      <color=#FFCC00>H</color>\uB85C \uC0AC\uC6A9\uD558\uBA70, \uB808\uBCA8\uC774
      \uC624\uB97C\uC218\uB85D <color=#FFCC00>\uCFE8\uD0C0\uC784</color>\uC774 \uC9E7\uC544\uC9D1\uB2C8\uB2E4."
  - clip: {fileID: 32900000, guid: 811b957aacb2c1546be70acae7f26bc6, type: 3}
    title: "\uC6CC\uD504 \uC9C0\uC810"
    body: "\uBC1C\uACAC\uD55C <color=#FFCC00>\uC6CC\uD504 \uC9C0\uC810</color>\uC740
      <color=#FFCC00>F\uB85C \uD65C\uC131\uD654</color>\uD55C \uB4A4 \uC774\uD6C4
      \uC774\uB3D9\uC5D0 \uC0AC\uC6A9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uAE30\uC9C0\uC640
      \uC9C0\uC5ED\uC744 \uBE60\uB974\uAC8C \uC624\uAC00\uB294 \uC9C0\uB984\uAE38\uC785\uB2C8\uB2E4."
  - clip: {fileID: 32900000, guid: f2cd63e328685e0439cff6f039c99786, type: 3}
    title: "\uC6B0\uC8FC\uC120 \uC218\uB9AC \uC18C\uAC1C"
    body: "\uC6B0\uC8FC\uC120 <color=#FFCC00>\uBCF5\uAD6C</color>\uC5D0 \uC0AC\uC6A9\uB418\uB294
      \uD2B9\uC218 \uC5D0\uB108\uC9C0\uC785\uB2C8\uB2E4. \uCDA9\uBD84\uD788 \uBAA8\uC73C\uBA74
      \uAE30\uC9C0\uC758 <color=#FFCC00>\uBCF5\uAD6C \uC7A5\uCE58</color>\uC5D0\uC11C
      \uC6B0\uC8FC\uC120 \uBCF5\uAD6C\uB97C \uC9C4\uD589\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
