  m_Script: {fileID: 11500000, guid: 3a466e23973e5e145bffecc7c46000e5, type: 3}
  m_Name: DiscoveryCueSet
  m_EditorClassIdentifier: 
  cues:
  - cueKey: facility:3
    safe: 1
    pages:
    - clip: {fileID: 32900000, guid: 5d6748ac97b814b419d8876d8ea5c8df, type: 3}
      title: "\uC2DC\uAC04\uC5D0\uB108\uC9C0 \uD569\uC131\uAE30 \uC18C\uAC1C"
      body: "\uC2DC\uAC04\uC5D0\uB108\uC9C0 <color=#FFCC00>\uCDA9\uC804 \uD0A4\uD2B8</color>\uB97C
        \uB9CC\uB4DC\uB294 \uC124\uBE44\uC785\uB2C8\uB2E4. \uC5EC\uAE30\uC11C \uB9CC\uB4E0
        \uD0A4\uD2B8\uB97C <color=#FFCC00>\uC804\uC1A1\uAE30</color>\uC5D0 \uB123\uC5B4
        \uC804\uC1A1\uB960\uC744 \uC62C\uB9BD\uB2C8\uB2E4."
  - cueKey: facility:6
    safe: 1
    pages:
    - clip: {fileID: 32900000, guid: f142b317af7ed3348815c9a0a3792e00, type: 3}
      title: "\uC6A9\uD574\uB85C \uC18C\uAC1C"
      body: "\uC7AC\uB8CC\uB97C \uB179\uC5EC <color=#FFCC00>\uC8FC\uAD34</color>
        \uB4F1 \uAE30\uCD08 \uC18C\uC7AC\uB97C \uB9CC\uB4DC\uB294 \uC124\uBE44\uC785\uB2C8\uB2E4."
  - cueKey: facility:9
    safe: 1
    pages:
    - clip: {fileID: 32900000, guid: 322ca78250a9b844d876659acfec8580, type: 3}
      title: "\uCC3D\uACE0 \uCD9C\uB825 \uD3EC\uD2B8 \uC18C\uAC1C"
      body: "<color=#FFCC00>\uCC3D\uACE0</color>\uC758 \uC544\uC774\uD15C\uC744 <color=#FFCC00>\uB808\uC77C</color>\uB85C
        \uAEBC\uB0B4 \uB2E4\uB978 \uC124\uBE44\uC5D0 \uC790\uB3D9 \uACF5\uAE09\uD558\uB294
        \uC124\uBE44\uC785\uB2C8\uB2E4."
  - cueKey: facility:8
    safe: 1
    pages:
    - clip: {fileID: 32900000, guid: 81dd591bc4bda294fb98fce2f0e9ed68, type: 3}
      title: "\uC800\uC7A5\uACE0 \uC18C\uAC1C"
      body: "\uB808\uC77C\uB85C \uB4E4\uC5B4\uC628 \uC544\uC774\uD15C\uC744 <color=#FFCC00>\uCC3D\uACE0\uC5D0
        \uC790\uB3D9 \uBCF4\uAD00</color>\uD558\uB294 \uC124\uBE44\uC785\uB2C8\uB2E4.
        <color=#FFCC00>\uCC3D\uACE0 \uCD9C\uB825 \uD3EC\uD2B8</color>(\uCC3D\uACE0\uC5D0\uC11C
        \uAEBC\uB0B4\uAE30)\uC758 \uBC18\uB300\uC785\uB2C8\uB2E4."
  - cueKey: facility:7
    safe: 1
    pages:
    - clip: {fileID: 32900000, guid: 4f10f2e33ccf64b449ee181d491128da, type: 3}
      title: "\uCF54\uC5B4 \uD569\uC131\uAE30 \uC18C\uAC1C"
      body: "<color=#FFCC00>\uCF54\uC5B4 \uAC15\uD654</color>\uC5D0 \uC4F0\uB294
        <color=#FFCC00>\uCF54\uC5B4 \uD0A4\uD2B8</color>\uB97C \uB9CC\uB4DC\uB294
        \uC124\uBE44\uC785\uB2C8\uB2E4."
  - cueKey: facility:4
    safe: 1
    pages:
    - clip: {fileID: 32900000, guid: 9e4ba08630d61b44b81b099c950b31d0, type: 3}
      title: "\uC0DD\uCCB4 \uBD84\uB9AC\uAE30 \uC18C\uAC1C"
      body: "\uC0DD\uCCB4 \uC7AC\uB8CC\uB97C \uBD84\uB9AC\uD574 <color=#FFCC00>\uC0C1\uC704
        \uC6D0\uB8CC</color>\uB97C \uC5BB\uB294 \uC124\uBE44\uC785\uB2C8\uB2E4. <color=#FFCC00>\uC5D0\uB108\uC9C0
        \uBCC0\uD658\uAE30</color>\uC640 \uD568\uAED8 \uC501\uB2C8\uB2E4."
    - clip: {fileID: 32900000, guid: c2d159ca6445c394ab52f9d177367dfa, type: 3}
      title: "\uC5D0\uB108\uC9C0 \uBCC0\uD658\uAE30 \uC18C\uAC1C"
      body: "\uC6D0\uB8CC\uB97C <color=#FFCC00>\uC5D0\uB108\uC9C0 \uD615\uD0DC</color>\uB85C
        \uBCC0\uD658\uD558\uB294 \uC124\uBE44\uC785\uB2C8\uB2E4. <color=#FFCC00>\uC0DD\uCCB4
        \uBD84\uB9AC\uAE30</color>\uC758 \uC0B0\uCD9C\uBB3C\uC744 \uBC1B\uC544 \uAC00\uACF5\uD569\uB2C8\uB2E4."
    - clip: {fileID: 32900000, guid: 13d959e406b878b469ce2c64998d5771, type: 3}
      title: "\uC6D0\uC7AC\uB8CC \uBB34\uD55C \uBCF5\uC81C"
      body: "<color=#FFCC00>\uC0DD\uCCB4 \uBD84\uB9AC\uAE30</color>\uC640 <color=#FFCC00>\uC5D0\uB108\uC9C0
        \uBCC0\uD658\uAE30</color>\uC758 \uCD9C\uB825\uC744 <color=#FFCC00>\uB808\uC77C</color>\uB85C
        \uC11C\uB85C \uBB3C\uB824 \uC21C\uD658\uC2DC\uD0A4\uBA74 \uC6D0\uC7AC\uB8CC\uAC00
        \uACC4\uC18D \uBD88\uC5B4\uB0A9\uB2C8\uB2E4. \uC774 <color=#FFCC00>\uC21C\uD658
        \uB77C\uC778</color>\uC73C\uB85C \uC7AC\uB8CC\uB97C \uBB34\uD55C\uD788 \uD655\uBCF4\uD558\uC138\uC694."
  - cueKey: returnstone
    safe: 1
    pages:
    - clip: {fileID: 32900000, guid: 15d371dcb197d2b4982308056828139e, type: 3}
      title: "\uADC0\uD658\uC11D"
      body: "<color=#FFCC00>\uADC0\uD658\uC11D</color>\uC744 \uC0AC\uC6A9\uD558\uBA74
        \uAE30\uC9C0\uB85C \uBE60\uB974\uAC8C \uBCF5\uADC0\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.
        <color=#FFCC00>H</color>\uB85C \uC0AC\uC6A9\uD558\uBA70, \uB808\uBCA8\uC774
        \uC624\uB97C\uC218\uB85D <color=#FFCC00>\uCFE8\uD0C0\uC784</color>\uC774
        \uC9E7\uC544\uC9D1\uB2C8\uB2E4."
  - cueKey: warp
    safe: 1
    pages:
    - clip: {fileID: 32900000, guid: 811b957aacb2c1546be70acae7f26bc6, type: 3}
      title: "\uC6CC\uD504 \uC9C0\uC810"
      body: "\uBC1C\uACAC\uD55C <color=#FFCC00>\uC6CC\uD504 \uC9C0\uC810</color>\uC740
        <color=#FFCC00>F\uB85C \uD65C\uC131\uD654</color>\uD55C \uB4A4 \uC774\uD6C4
        \uC774\uB3D9\uC5D0 \uC0AC\uC6A9\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uAE30\uC9C0\uC640
        \uC9C0\uC5ED\uC744 \uBE60\uB974\uAC8C \uC624\uAC00\uB294 \uC9C0\uB984\uAE38\uC785\uB2C8\uB2E4."
  - cueKey: shiprepair
    safe: 0
    pages:
    - clip: {fileID: 32900000, guid: f2cd63e328685e0439cff6f039c99786, type: 3}
      title: "\uC6B0\uC8FC\uC120 \uC218\uB9AC \uC18C\uAC1C"
      body: "\uC6B0\uC8FC\uC120 <color=#FFCC00>\uBCF5\uAD6C</color>\uC5D0 \uC0AC\uC6A9\uB418\uB294
        \uD2B9\uC218 \uC5D0\uB108\uC9C0\uC785\uB2C8\uB2E4. \uCDA9\uBD84\uD788 \uBAA8\uC73C\uBA74
        \uAE30\uC9C0\uC758 <color=#FFCC00>\uBCF5\uAD6C \uC7A5\uCE58</color>\uC5D0\uC11C
        \uC6B0\uC8FC\uC120 \uBCF5\uAD6C\uB97C \uC9C4\uD589\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
