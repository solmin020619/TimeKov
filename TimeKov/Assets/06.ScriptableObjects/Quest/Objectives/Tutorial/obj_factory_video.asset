  label: "\uC124\uBE44 \uAC00\uACF5 \uC548\uB0B4\uB97C \uD655\uC778\uD558\uC138\uC694."
  startGracePeriod: 0.1
  pages:
  - clip: {fileID: 32900000, guid: c5d71720838a336439ace25cf565ea37, type: 3}
    title: "\uC124\uBE44 \uAC00\uACF5"
    body: "<color=#FFCC00>\uAC00\uBC29\uC774\uB098 \uCC3D\uACE0</color>\uC5D0 \uC788\uB294
      \uC544\uC774\uD15C\uC744 \uC124\uBE44\uC5D0 <color=#FFCC00>\uB123\uC744 \uC218
      \uC788\uC73C\uBA70</color>, \uD574\uB2F9 \uC124\uBE44\uC5D0 \uB9DE\uB294 <color=#FFCC00>\uC870\uD569
      \uACF5\uC2DD</color>\uC774 \uC788\uC744 \uACBD\uC6B0 \uC815\uC0C1\uC801\uC73C\uB85C
      \uC791\uB3D9\uD569\uB2C8\uB2E4.\n\uAC01 \uC124\uBE44\uB294 \uD55C \uBC88\uC5D0
      <color=#FFCC00>\uD558\uB098\uC758 \uC870\uD569 \uACF5\uC2DD</color>\uC73C\uB85C\uB9CC
      \uC0DD\uC0B0\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - clip: {fileID: 32900000, guid: 8a754c7517d9b2843b3dd8dbe0e4ca29, type: 3}
    title: "\uC0DD\uC0B0\uD488 \uC218\uB839"
    body: "\uC124\uBE44\uC758 <color=#FFCC00>\uAC00\uACF5\uC774 \uC644\uB8CC</color>\uB418\uBA74
      \uAC00\uBC29\uC774\uB098 \uCC3D\uACE0\uB85C <color=#FFCC00>\uC0DD\uC0B0\uD488\uC744
      \uC218\uB839</color>\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
