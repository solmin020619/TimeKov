  m_EditorClassIdentifier: 
  label: "\uC124\uBE44 \uAC00\uACF5 \uBC29\uBC95\uC744 \uD655\uC778\uD558\uC138\uC694."
  startGracePeriod: 0.1
  pages:
  - clip: {fileID: 32900000, guid: 7a195cb5442f14a42982ae5b7dd0398e, type: 3}
    title: "\uC124\uBE44 \uC5F4\uAE30"
    body: "\uC124\uCE58\uD55C \uC124\uBE44\uC5D0 \uB2E4\uAC00\uAC00 <color=#FFCC00>F</color>\uB97C
      \uB204\uB974\uBA74 \uC124\uBE44 UI\uAC00 \uC5F4\uB9BD\uB2C8\uB2E4. \uC774 \uD654\uBA74\uC5D0\uC11C
      <color=#FFCC00>\uC5F0\uB8CC</color>\uC640 <color=#FFCC00>\uC7AC\uB8CC</color>\uB97C
      \uB123\uC5B4 \uC6D0\uD558\uB294 \uBB3C\uAC74\uC744 <color=#FFCC00>\uAC00\uACF5</color>\uD560
      \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - clip: {fileID: 32900000, guid: 051bc50f018f7ad4d8a98ad2578168d7, type: 3}
    title: "\uC7AC\uB8CC \uD22C\uC785\uACFC \uAC00\uACF5"
    body: "\uBA3C\uC800 <color=#FFCC00>\uC5F0\uB8CC</color>\uAC00 \uD544\uC694\uD569\uB2C8\uB2E4.
      \uAC00\uBC29\uC758 <color=#FFCC00>\uB098\uBB47\uAC00\uC9C0</color>\uB97C <color=#FFCC00>\uC5F0\uB8CC
      \uC2AC\uB86F</color>\uC5D0 \uB4DC\uB798\uADF8\uD574 \uB123\uC73C\uC138\uC694(\uB098\uBB47\uAC00\uC9C0\uB294
      <color=#FFCC00>\uC624\uD06C \uD2B8\uB9AC</color>\uC5D0\uC11C \uB098\uC635\uB2C8\uB2E4).
      \uC774\uC5B4\uC11C <color=#FFCC00>\uAC00\uBC29\uC774\uB098 \uCC3D\uACE0</color>\uC758
      \uC7AC\uB8CC\uB97C <color=#FFCC00>\uC7AC\uB8CC \uC2AC\uB86F</color>\uC73C\uB85C
      \uB4DC\uB798\uADF8\uD558\uBA74, \uB9DE\uB294 <color=#FFCC00>\uB808\uC2DC\uD53C</color>\uAC00
      \uC788\uC744 \uB54C <color=#FFCC00>\uAC00\uACF5</color>\uC774 \uC2DC\uC791\uB429\uB2C8\uB2E4."
  - clip: {fileID: 32900000, guid: 93fdb0467e9e1d64794e128ab30f0e06, type: 3}
    title: "\uC0DD\uC0B0\uD488 \uC218\uB839"
    body: "<color=#FFCC00>\uAC00\uACF5\uC774 \uC644\uB8CC</color>\uB418\uBA74 <color=#FFCC00>\uBAA8\uB450
      \uBC1B\uAE30</color>\uB85C \uC0DD\uC0B0\uD488\uC744 \uAC00\uBC29\uC774\uB098
      \uCC3D\uACE0\uB85C <color=#FFCC00>\uC218\uB839</color>\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - clip: {fileID: 32900000, guid: d7bc022beed29754ab036915378f45c9, type: 3}
    title: "\uB808\uC2DC\uD53C \uBCC0\uACBD"
    body: "\uD55C \uC124\uBE44\uAC00 \uC5EC\uB7EC <color=#FFCC00>\uB808\uC2DC\uD53C</color>\uB97C
      \uB9CC\uB4E4 \uC218 \uC788\uC744 \uB54C, \uB9CC\uB4E4\uACE0 \uC2F6\uC740 <color=#FFCC00>\uB808\uC2DC\uD53C</color>\uB97C
      <color=#FFCC00>\uD074\uB9AD</color>\uD574 <color=#FFCC00>\uBC14\uAFC0 \uC218
      \uC788\uC2B5\uB2C8\uB2E4</color>. (\uD55C \uBC88\uC5D0 \uD558\uB098\uC758 \uB808\uC2DC\uD53C\uB9CC
      \uAC00\uB3D9)"
