{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "3d17e81f5dc948a6a515832349aaa232",
    "m_Group": {
        "m_Id": "306c4831fcf641eaa145811705cd9528"
    },
    "m_Name": "HS_ImpactArray (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -2811.19970703125,
            "y": -130.3999481201172,
            "width": 246.39990234375,
            "height": 141.5999755859375
        }
    },
    "m_Slots": [
        {
            "m_Id": "4a5e79d61ce140dbad78ccbf75fff3b5"
        },
        {
            "m_Id": "06b33db78fbc4d839e299e9580945bf1"
        },
        {
            "m_Id": "6f642997b66f42b1a21b54969a8b2ba6"
        },
        {
            "m_Id": "fe98a66d81674cbe8ee4d83782f72828"
        }
    ],
    "synonyms": [],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 0,
    "m_FunctionName": "HS_ImpactArray",
    "m_FunctionSource": "33dc1c88b7d074347af55355107d2438",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "\r\n    float3 g = floor(UV * CellDensity);\r\n    float3 f = frac(UV * CellDensity);\r\n\r\n    float3 res = float3(8.0, 8.0, 8.0);\r\n\r\n    // hash matrix (inlined from voronoi_noise_randomVector)\r\n    float3x3 m = float3x3(\r\n        15.27, 47.63, 99.41,\r\n        89.98, 95.07, 38.39,\r\n        33.83, 51.06, 60.77\r\n    );\r\n\r\n    for (int y = -1; y <= 1; y++)\r\n    {\r\n        for (int x = -1; x <= 1; x++)\r\n        {\r\n            for (int z = -1; z <= 1; z++)\r\n            {\r\n                float3 lattice = float3(x, y, z);\r\n\r\n                // ---- inlined random vector ----\r\n                float3 p = frac(sin(mul(g + lattice, m)) * 46839.32);\r\n\r\n                float3 offset;\r\n                offset.x = sin(p.y * AngleOffset) * 0.5 + 0.5;\r\n                offset.y = cos(p.x * AngleOffset) * 0.5 + 0.5;\r\n                offset.z = sin(p.z * AngleOffset) * 0.5 + 0.5;\r\n                // --------------------------------\r\n\r\n                float3 v = lattice + offset - f;\r\n                float d = dot(v, v);\r\n\r\n                if (d < res.x)\r\n                {\r\n                    res.y = res.x;\r\n                    res.x = d;\r\n                    res.z = offset.x;\r\n                }\r\n                else if (d < res.y)\r\n                {\r\n                    res.y = d;\r\n                }\r\n            }\r\n        }\r\n    }\r\n\r\n    Value = res.x;\r\n    Cells = res.z;\r\n"
}

